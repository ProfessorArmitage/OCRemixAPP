{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/cdn/iterations/:path*", "destination": "https://iterations.org/:path*" },
    { "source": "/cdn/djpretzel/:path*",  "destination": "http://djpretzel.web.aplus.net/:path*" },
    { "source": "/cdn/ocremix/:path*",    "destination": "https://ocremix.org/:path*" }
  ]
}
